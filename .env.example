# Which model to reason with. Structured invoices never need one.
#   xai    -> Grok via https://api.x.ai/v1 (needs XAI_API_KEY)
#   openai -> OpenAI (needs OPENAI_API_KEY)
#   local  -> any OpenAI-compatible server, e.g. LM Studio on :1235
#   none   -> deterministic only; unstructured files go to the human queue
# Unset: xai if XAI_API_KEY is present, else openai if OPENAI_API_KEY is present, else none.
LLM_PROVIDER=none

XAI_API_KEY=
XAI_MODEL=grok-4.5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LOCAL_BASE_URL=http://localhost:1235/v1
LOCAL_MODEL=qwen3.8-27b-mlx
